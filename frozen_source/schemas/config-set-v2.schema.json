{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wearvision://schemas/config-set-v2",
  "title": "WearVision ER-05A configuration set manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "ConfigSetId",
    "ProfileKind",
    "ScientificUse",
    "AuthorizedStage",
    "CanonicalizationVersion",
    "ApprovalStatus",
    "OwnerId",
    "CreatedById",
    "UnresolvedPlaceholders",
    "Files"
  ],
  "properties": {
    "SchemaVersion": { "const": "config-set-v2" },
    "ConfigSetId": { "type": "string", "minLength": 1 },
    "ProfileKind": { "enum": ["TestFixtureOnly", "T5Pilot", "T6Scientific"] },
    "ScientificUse": { "type": "string", "minLength": 1 },
    "AuthorizedStage": { "enum": ["T0", "T1", "T2", "T3", "T4", "T5", "T6"] },
    "CanonicalizationVersion": { "type": "string", "minLength": 1 },
    "ApprovalStatus": { "enum": ["NotApproved", "Approved", "Rejected"] },
    "OwnerId": { "type": "string", "minLength": 1 },
    "CreatedById": { "type": "string", "minLength": 1 },
    "UnresolvedPlaceholders": { "type": "array", "items": { "type": "string" } },
    "Files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["RelativePath", "Sha256", "Role"],
        "properties": {
          "RelativePath": { "type": "string", "minLength": 1 },
          "Sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
          "Role": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
